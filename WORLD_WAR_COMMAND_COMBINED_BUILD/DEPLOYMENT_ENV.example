# Set these securely in your hosting provider. Never commit actual credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/wwc_2f?sslmode=require
BETTER_AUTH_URL=https://YOUR-NEW-DOMAIN.example
BETTER_AUTH_SECRET=REPLACE_WITH_SECURE_RANDOM_32_PLUS_BYTES
VITE_AUTH_ENABLED=true
