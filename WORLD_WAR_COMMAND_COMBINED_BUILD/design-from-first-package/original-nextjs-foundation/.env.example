# PostgreSQL database (Neon, Supabase, Railway or any PostgreSQL provider)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/worldwarcommand?sslmode=require"
# Email OTP delivery. Without SMTP settings, registration will not deliver email codes.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
SMTP_FROM="WORLD WAR COMMAND <noreply@example.com>"
# Generate a long random secret: openssl rand -base64 48
SESSION_SECRET="replace-with-at-least-32-random-characters"
APP_URL="http://localhost:3000"
NODE_ENV="development"
